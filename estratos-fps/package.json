{
  "name": "estratos-fps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run && node scripts/check-arquitectura.mjs && node scripts/python.mjs ../tools/check_palette.py",
    "test": "vitest run",
    "assets": "node scripts/python.mjs ../tools/gen_assets.py && node scripts/python.mjs ../tools/check_palette.py",
    "simular": "node scripts/simular.mjs",
    "smoke": "node scripts/smoke.mjs",
    "itch": "npm run build && node scripts/itch.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.1.0",
    "@fontsource/pixelify-sans": "^5.1.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "playwright": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
